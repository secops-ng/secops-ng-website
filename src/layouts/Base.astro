---
export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'SecOps-NG — Sovereign Security for the EU',
  description = 'A collective building sovereign, durable, agentic security for mid-size European organizations.',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="wordmark" aria-label="SecOps-NG home">
          <span class="wordmark-mark">▣</span>
          <span class="wordmark-text">SecOps<span class="wordmark-accent">-NG</span></span>
        </a>
        <nav class="site-nav" aria-label="Primary">
          <a href="/">Home</a>
          <a href="/about">About</a>
          <a href="/blog">Blog</a>
          <a href="https://github.com/secops-ng" rel="noopener" target="_blank">GitHub</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <p class="footer-tag">
          Project SecOps-NG — a collective for sovereign EU security.
        </p>
        <p class="footer-licenses">
          Content licensed <a href="https://creativecommons.org/licenses/by-sa/4.0/" rel="noopener" target="_blank">CC BY-SA 4.0</a>.
          Code licensed <a href="https://www.apache.org/licenses/LICENSE-2.0" rel="noopener" target="_blank">Apache-2.0</a>.
        </p>
        <p class="footer-links">
          <a href="https://github.com/secops-ng" rel="noopener" target="_blank">github.com/secops-ng</a>
        </p>
      </div>
    </footer>

    <style is:global>
      :root {
        --ink: #0c1116;
        --ink-soft: #2a3340;
        --paper: #f6f4ef;
        --paper-soft: #ecead9;
        --accent: #c8552d;
        --accent-soft: #e8a07d;
        --rule: #d8d3c4;
        --max-w: 72rem;
        --font-sans: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        --font-mono: ui-monospace, SFMono-Regular, "JetBrains Mono", Menlo, Consolas, monospace;
      }

      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        background: var(--paper);
        color: var(--ink);
        font-family: var(--font-sans);
        font-size: 17px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; }

      .container {
        max-width: var(--max-w);
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      /* Header */
      .site-header {
        border-bottom: 1px solid var(--rule);
        background: var(--paper);
      }
      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 1.25rem;
        padding-bottom: 1.25rem;
        gap: 1.5rem;
        flex-wrap: wrap;
      }
      .wordmark {
        display: inline-flex;
        align-items: baseline;
        gap: 0.5rem;
        color: var(--ink);
        font-weight: 700;
        font-size: 1.25rem;
        letter-spacing: -0.01em;
      }
      .wordmark:hover { text-decoration: none; }
      .wordmark-mark { color: var(--accent); font-size: 1.4rem; line-height: 1; }
      .wordmark-accent { color: var(--accent); }
      .site-nav { display: flex; gap: 1.5rem; flex-wrap: wrap; }
      .site-nav a {
        color: var(--ink-soft);
        font-weight: 500;
      }
      .site-nav a:hover { color: var(--accent); text-decoration: none; }

      /* Main spacing */
      main { display: block; }

      /* Footer */
      .site-footer {
        margin-top: 5rem;
        border-top: 1px solid var(--rule);
        background: var(--paper-soft);
        padding: 2.5rem 0;
        color: var(--ink-soft);
        font-size: 0.95rem;
      }
      .footer-inner { display: flex; flex-direction: column; gap: 0.5rem; }
      .footer-tag { margin: 0; font-weight: 600; color: var(--ink); }
      .footer-licenses, .footer-links { margin: 0; }

      /* Typography helpers used across pages */
      h1, h2, h3 { color: var(--ink); line-height: 1.2; letter-spacing: -0.01em; }
      h1 { font-size: clamp(2rem, 4.5vw, 3.25rem); margin: 0 0 1rem; }
      h2 { font-size: clamp(1.5rem, 2.6vw, 2rem); margin: 0 0 1rem; }
      h3 { font-size: 1.2rem; margin: 0 0 0.5rem; }
      p { margin: 0 0 1rem; }

      .eyebrow {
        display: inline-block;
        font-family: var(--font-mono);
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--accent);
        margin-bottom: 0.75rem;
      }

      .btn {
        display: inline-block;
        padding: 0.7rem 1.2rem;
        border: 1.5px solid var(--ink);
        border-radius: 2px;
        color: var(--ink);
        font-weight: 600;
        background: transparent;
      }
      .btn:hover { background: var(--ink); color: var(--paper); text-decoration: none; }
      .btn-primary { background: var(--ink); color: var(--paper); }
      .btn-primary:hover { background: var(--accent); border-color: var(--accent); color: var(--paper); }

      .cta-row { display: flex; gap: 0.75rem; flex-wrap: wrap; }
    </style>
  </body>
</html>
